# Optional. Enables the AI semantic evaluation layer in scoring/ai.py and
# scoring/evidence_reasoner.py. Scoring works fully without this — see
# docs/scoring.md.
ANTHROPIC_API_KEY=

# Optional. Required only for `jobs run` (scheduled discovery) to send
# email alerts, and for `jobs notifications test`. Without these, the
# pipeline still runs and evaluates opportunities — it just can't send
# notifications (see docs/alerts.md). Never commit real values here.
#
# Zoho SMTP typically uses smtp.zoho.com on port 587 with STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Set SMTP_USE_TLS=false only for a provider/port that doesn't use STARTTLS.
SMTP_USE_TLS=true

# Where alert emails are sent.
CAREERS_ALERT_EMAIL=
